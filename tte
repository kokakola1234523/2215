copyAllBtn.MouseButton1Click:Connect(function()
    local combinedText = "PayWay: " .. paywayBox.Text .. "\nTelegram: " .. tgBox.Text
    if setclipboard then
        setclipboard(combinedText)
        copyAllBtn.Text = "Copied Both!"
    end
    task.wait(2)
    copyAllBtn.Text = "Copy Both Links"
end)
