-- 8. Functions សម្រាប់ Copy
---------------------------------------------------------
local function handleCopy(button, textToCopy, originalText, originalColor)
    if setclipboard then
        setclipboard(textToCopy)
        button.Text = "Copied!"
        button.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
    else
        button.Text = "Ctrl+C"
    end
    
    task.wait(2)
    button.Text = originalText
    button.BackgroundColor3 = originalColor
end

copyPaywayBtn.MouseButton1Click:Connect(function()
    handleCopy(copyPaywayBtn, paywayBox.Text, "Copy PayWay", Color3.fromRGB(0, 120, 215))
end)

copyTgBtn.MouseButton1Click:Connect(function()
    handleCopy(copyTgBtn, tgBox.Text, "Copy Telegram", Color3.fromRGB(0, 136, 204))
end)

copyAllBtn.MouseButton1Click:Connect(function()
    local combinedText = "PayWay: " .. paywayBox.Text .. "\nTelegram: " .. tgBox.Text
    handleCopy(copyAllBtn, combinedText, "Copy Both Links", Color3.fromRGB(40, 167, 69))
end)
