-- 8. Functions សម្រាប់ បើក Direct Link ឬ Copy
---------------------------------------------------------
local function openOrCopyLink(button, url, originalText, originalColor)
    -- ១. ព្យាយាមបើក Web Direct (ប្រសិនបើ Executor support openurl)
    if openurl then
        openurl(url)
        button.Text = "Opening..."
    elseif setclipboard then
        -- ២. ប្រសិនបើ Executor មិន support openurl ទេ វានឹង Copy ជំនួស
        setclipboard(url)
        button.Text = "Copied Link!"
        button.BackgroundColor3 = Color3.fromRGB(40, 167, 69)
    else
        button.Text = "Ctrl+C"
    end
    
    task.wait(2)
    button.Text = originalText
    button.BackgroundColor3 = originalColor
end

copyPaywayBtn.MouseButton1Click:Connect(function()
    openOrCopyLink(copyPaywayBtn, paywayBox.Text, "Open PayWay", Color3.fromRGB(0, 120, 215))
end)

