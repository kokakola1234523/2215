-- Auto Chop Trees integration
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TreesFolder = workspace:WaitForChild("Map"):WaitForChild("Foliage")
local FogPart = workspace:WaitForChild("Map"):WaitForChild("Boundaries"):WaitForChild("Fog")

local valueAxe = "1_" .. player.UserId
local remoteAxe = ReplicatedStorage:WaitForChild("RemoteEvents"):WaitForChild("ToolDamageObject")
local autoChopEnabled = false

local function getFogBounds()
    if not FogPart then return Vector3.new(0,0,0), 300 end
    
    local pos = Vector3.new(0,0,0)
    local fogRadius = 300
    
    if FogPart:IsA("BasePart") then
        pos = FogPart.Position
        local size = FogPart.Size
        fogRadius = math.max(size.X, size.Z) / 2
    elseif FogPart:IsA("Model") then
        local cf, size = FogPart:GetBoundingBox()
        pos = cf.Position
        fogRadius = math.max(size.X, size.Z) / 2
    end
    
    return pos, fogRadius + 50
end

TabMain:CreateToggle({
    Name = '<font size="24"><b>កាប់ដើមឈើរ</b></font> Auto Chop Tree',
    CurrentValue = false,
    Flag = "AutoChopToggle",
    Callback = function(Value)
        autoChopEnabled = Value

        if autoChopEnabled then
            task.spawn(function()
                while autoChopEnabled do
                    pcall(function()
                        local inventory = player:FindFirstChild("Inventory")
                        local axe = inventory and inventory:FindFirstChild("Old Axe")
                        if not axe then return end

                        local fogPos, fogRadius = getFogBounds()

                        for _, v in ipairs(TreesFolder:GetChildren()) do
                            if not autoChopEnabled then break end
                            
                            if v.Name == "Small Tree" and v:FindFirstChild("Trunk") then
                                local distance = (v.Trunk.Position - fogPos).Magnitude
                                
                                if distance <= fogRadius then
                                    task.spawn(function()
                                        remoteAxe:InvokeServer(v, axe, valueAxe, CFrame.new(23.124, 3.939, -36.213))
                                    end)
                                end
                            end
                        end
                    end)
                    task.wait(0.15)
                end
            end)
        end
    end,
})

