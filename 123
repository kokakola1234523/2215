-- Safe GC for Prices & Sheckles
pcall(function()
    for _, v in pairs(getgc()) do
        if type(v) == "function" then
            local success, info = pcall(debug.info, v, "s")
            if success and info and info:match("RestockStoreController") then
                local upvalues = debug.getupvalues(v)
                for _, upv in pairs(upvalues) do
                    if type(upv) == "table" then
                        if upv.Data and upv.Data.Sheckles ~= nil then
                            playerdata = upv
                        elseif not prices[1] and type(next(upv)) == "string" then
                            table.insert(prices, upv)
                        end
                    end
                end
            end
        end
    end
end)

local function canAfford(itemName)
    if not playerdata or not playerdata.Data then return true end
    local sheckles = playerdata.Data.Sheckles or 0
    
    for _, priceTable in pairs(prices) do
        if priceTable[itemName] and priceTable[itemName].price then
            return sheckles >= priceTable[itemName].price
        end
    end
    return true
end

-- Auto Buy Loop Function
local lastBuyAttempt = {}

task.spawn(function()
    while task.wait(0.2) do
        if autoBuyEnabled then
            local activeItems = {}
            for _, category in pairs(selectedItems) do
                for _, itemName in ipairs(category) do
                    if itemName ~= "None" and itemName ~= "" and not itemName:match("^%-%-%-") then
                        table.insert(activeItems, itemName)
                    end
                end
            end

            for _, shop in ipairs(Shops) do
                if shop.Stock and shop.Event then
                    for _, item in ipairs(shop.Stock:GetChildren()) do
                        if item and item.Value > 0 and table.find(activeItems, item.Name) then
                            if canAfford(item.Name) then
                                pcall(function()
                                    shop.Event:Fire(item.Name)
                                end)
                                task.wait(0.1)
                            else
                                local now = tick()
                                if not lastBuyAttempt[item.Name] or (now - lastBuyAttempt[item.Name]) > 10 then
                                    lastBuyAttempt[item.Name] = now
                                    window:Notify({
                                        Title = "⚠️ លុយមិនគ្រប់",
                                        Content = "មិនគ្រប់ Sheckles សម្រាប់ទិញ: " .. item.Name,
                                        Duration = 2,
                                        Image = 4483362458
                                    })
                                end
                            end
                        end
                    end
                end
            end
        end
    end
end)

