local function getCharacterParts()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local rootPart = character:WaitForChild("HumanoidRootPart", 5)
    return character, rootPart
end

local function setNoclip(enabled)
    local character = LocalPlayer.Character
    if not character then return end
    
    if enabled then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                for _, part in ipairs(character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end)
        end
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.CanCollide = true
            end
        end
    end
end

local function walkAndInteract(targetPart)
    if not autoCollectEnabled then return end
    
    local character, humanoidRootPart = getCharacterParts()
    if not humanoidRootPart or not targetPart or not targetPart.Parent then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    setNoclip(true)
    
    local targetPosition
    if targetPart:IsA("Model") then
        targetPosition = targetPart:GetPivot().Position
    elseif targetPart:IsA("BasePart") then
        targetPosition = targetPart.Position
    else
        local part = targetPart:FindFirstChildWhichIsA("BasePart", true)
        if part then
            targetPosition = part.Position
        else
            setNoclip(false)
            return
        end
    end
    
    humanoid:MoveTo(targetPosition)
    
    local connection
    local reached = false
    
    connection = RunService.Heartbeat:Connect(function()
        if not autoCollectEnabled or not targetPart or not targetPart.Parent then
            if connection then connection:Disconnect() end
            return
        end
        
        if targetPart:IsA("Model") then
            targetPosition = targetPart:GetPivot().Position
        elseif targetPart:IsA("BasePart") then
            targetPosition = targetPosition or targetPart.Position
        end
        
        humanoid:MoveTo(targetPosition)
        
        if (humanoidRootPart.Position - targetPosition).Magnitude <= 4 then
            reached = true
            if connection then connection:Disconnect() end
        end
    end)
    
    local startTime = tick()
    while autoCollectEnabled and not reached and targetPart and targetPart.Parent and (tick() - startTime < 10) do
        task.wait(0.1)
    end
    
    if connection then connection:Disconnect() end
    setNoclip(false)
    
    if autoCollectEnabled then
        local prompt = targetPart:FindFirstChildOfClass("ProximityPrompt", true)
        if prompt then
            prompt.MaxActivationDistance = 9999
            fireproximityprompt(prompt)
        end
    end
    task.wait(0.2)
end

local function processItems()
    if isTeleporting or not spawnLocationsFolder then return end
    isTeleporting = true
    
    while autoCollectEnabled do
        local children = spawnLocationsFolder:GetChildren()
        if #children == 0 then break end
        
        local currentItem = children[1]
        if currentItem then
            pcall(function()
                walkAndInteract(currentItem)
            end)
        end
        task.wait(0.1)
    end
    
    isTeleporting = false
    setNoclip(false)
end

if spawnLocationsFolder then
    spawnLocationsFolder.ChildAdded:Connect(function()
        if autoCollectEnabled and not isTeleporting then
            task.spawn(processItems)
        end
    end)
end

