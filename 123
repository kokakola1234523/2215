local function collectDroppedItems()
    local droppedItemsFolder = Workspace:FindFirstChild("DroppedItems")
    
    if droppedItemsFolder then
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local humanoidRootPart = character:WaitForChild("HumanoidRootPart", 5)
        
        if not humanoidRootPart then return end
        
        for _, item in ipairs(droppedItemsFolder:GetChildren()) do
            if not autoCollectEnabled then break end
            
            local promptAnchor = item:FindFirstChild("PromptAnchor")
            local prompt = promptAnchor and promptAnchor:FindFirstChildOfClass("ProximityPrompt") 
                           or item:FindFirstChildOfClass("ProximityPrompt")
            
            local targetPart = item:IsA("Model") and item.PrimaryPart or item:IsA("BasePart") and item
            
            if targetPart and prompt then
                humanoidRootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                task.wait(0.3)
                
                fireproximityprompt(prompt)
                
                task.wait(0.3)
            end
        end
    end
end

