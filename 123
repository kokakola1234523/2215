    })
end

local function SendItemWithReceipt(category, itemKey, categoryNameKhmer)
    local targetId = getUserId(TargetUsername)
    if not targetId then
        HENG:Notify({Title = "រកមិនឃើញ", Content = "រកមិនឃើញគណនីឈ្មោះ " .. TargetUsername .. " ឡើយ!", Duration = 5, Image = 4483362458})
        return
    end

    HENG:Notify({Title = "Mailbox", Content = "កំពុងដំណើរការផ្ញើ...", Duration = 2, Image = 4483362458})
    
    local itemsToSend = {
        {
            Category = category,             
            ItemKey = itemKey, 
            Count = Amount          
        }
    }
    
    task.wait(0.5)
    local success, err = pcall(function()
        return Networking.Mailbox.SendBatch:Fire(targetId, itemsToSend, "Auto Sent with Receipt!")
    end)
    
    if success then
        ShowReceipt(TargetUsername, categoryNameKhmer, itemKey, Amount)
    else
        HENG:Notify({Title = "កំហុសប្រព័ន្ធ", Content = "ការផ្ញើបរាជ័យ: " .. tostring(err), Duration = 5, Image = 4483362458})
    end
end

