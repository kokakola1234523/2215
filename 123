            "📦 ប្រភេទ: %s\n" ..
            "🌱 ទំនិញ: %s\n" ..
            "🔢 ចំនួន: %d\n" ..
            "ស្ថានភាព: ផ្ញើរួចរាល់ ✅\n" ..
            "---------------------------",
            recipient, category, itemName, count
        ),
        Duration = 30,
