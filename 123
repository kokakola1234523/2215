local function findMyPlot()
    local gardens = Workspace:FindFirstChild("Gardens")
    if not gardens then return nil end
    
    for _, plot in ipairs(gardens:GetChildren()) do
        local ownerVal = plot:FindFirstChild("Owner") or plot:FindFirstChild("Player")
        local ownerAttr = plot:GetAttribute("Owner") or plot:GetAttribute("Player")
        
        if (ownerVal and (ownerVal.Value == LocalPlayer.Name or ownerVal.Value == LocalPlayer))
            or (ownerAttr == LocalPlayer.Name)
            or (plot.Name == LocalPlayer.Name)
        then
            return plot
        end
    end
    
    return gardens:FindFirstChild("Plot4") or gardens:GetChildren()[1]
end

local function setupAutoPlay(character)
    if not character then return end
    
    local humanoid = character:WaitForChild("Humanoid", 5)
    local rootPart = character:WaitForChild("HumanoidRootPart", 5)
    if not humanoid or not rootPart then return end

    local myPlot = findMyPlot()
    if not myPlot then return end
    
    local visualFolder = myPlot:WaitForChild("Visual", 5)
    local plantArea = visualFolder and visualFolder:WaitForChild("PlantAreaColumn1", 5)
    local plantsFolder = myPlot:WaitForChild("Plants", 5)

    if noclipConnection then noclipConnection:Disconnect() end
    noclipConnection = RunService.Stepped:Connect(function()
        if autoPlantEnabled and character and character.Parent then
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    part.CanCollide = false
                end
            end
        end
    end)

    local function getRandomPositionInPart(part)
        local size = part.Size
        local randomX = math.random(-size.X / 2 + 2, size.X / 2 - 2)
        local randomZ = math.random(-size.Z / 2 + 2, size.Z / 2 - 2)
        local randomY = size.Y / 2 + 1

        local targetCFrame = part.CFrame * CFrame.new(randomX, randomY, randomZ)
        return targetCFrame.Position
    end

    if plantArea then
        task.spawn(function()
            while autoPlantEnabled and character and character.Parent and humanoid.Health > 0 do
                local targetPos = getRandomPositionInPart(plantArea)
                humanoid:MoveTo(targetPos)
                
                local isMoving = true
                local timer = 0
                while isMoving and autoPlantEnabled and character and character.Parent and humanoid.Health > 0 do
                    timer = timer + 0.1
                    local distance = (rootPart.Position - targetPos).Magnitude
                    if distance < 3 or timer > 6 then
                        isMoving = false
                    end
                    task.wait(0.1)
                end
            end
        end)
    end

    local function disableCollision(object)
        if object:IsA("BasePart") then
            object.CanCollide = false
            object.CanQuery = false
        end
    end

    if plantsFolder then
        plantsFolder.DescendantAdded:Connect(function(descendant)
            if autoPlantEnabled then
                disableCollision(descendant)
            end
        end)
        for _, descendant in ipairs(plantsFolder:GetDescendants()) do
            if autoPlantEnabled then
                disableCollision(descendant)
            end
        end
    end
end

LocalPlayer.CharacterAdded:Connect(function(newCharacter)
    if autoPlantEnabled then
        setupAutoPlay(newCharacter)
    end
end)

