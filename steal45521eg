-- ១. កូដបញ្ជាកាមេរ៉ា (Camera System)
-- ==========================================
local distance = 12
local angleX = 0 -- មុំងាកឆ្វេង/ស្តាំ
local angleY = 15 -- មុំងាកឡើង/ចុះ

local isRightMouseDown = false

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		isRightMouseDown = true
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		isRightMouseDown = false
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end
end)

UserInputService.InputChanged:Connect(function(input, gameProcessed)
	if isRightMouseDown and input.UserInputType == Enum.UserInputType.MouseMovement then
		angleX = angleX - input.Delta.X * 0.4
		angleY = math.clamp(angleY - input.Delta.Y * 0.4, -60, 80)
	end
end)

RunService.RenderStepped:Connect(function()
	local character = player.Character
	if character and character:FindFirstChild("HumanoidRootPart") then
		local rootPos = character.HumanoidRootPart.Position + Vector3.new(0, 2.5, 0)
		local rotation = CFrame.Angles(0, math.rad(angleX), 0) * CFrame.Angles(math.rad(angleY), 0, 0)
		local cameraPosition = rootPos + rotation * Vector3.new(0, 0, distance)
		
		camera.CFrame = CFrame.new(cameraPosition, rootPos)
	end
end)


-- ==========================================
-- ២. កូដ Noclip & Fly ជាប់រហូត (Permanent Fly & Noclip)
-- ==========================================
local bodyVelocity = nil
local bodyGyro = nil

local function enableFly(hrp)
	if not bodyVelocity or bodyVelocity.Parent ~= hrp then
		bodyVelocity = Instance.new("BodyVelocity")
		bodyVelocity.Velocity = Vector3.new(0, 0, 0)
		bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bodyVelocity.Parent = hrp
	end

	if not bodyGyro or bodyGyro.Parent ~= hrp then
		bodyGyro = Instance.new("BodyGyro")
		bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
		bodyGyro.CFrame = hrp.CFrame
		bodyGyro.Parent = hrp
	end
end

local function disableFly()
	if bodyVelocity then
		bodyVelocity:Destroy()
		bodyVelocity = nil
	end
	if bodyGyro then
		bodyGyro:Destroy()
		bodyGyro = nil
	end
end

RunService.Stepped:Connect(function()
	local character = player.Character
	if character and character:FindFirstChild("HumanoidRootPart") then
		local hrp = character.HumanoidRootPart
		
		if getgenv().AutoInteract then
			-- បើក Noclip (បុកធ្លុះជញ្ជាំង)
			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") and part.CanCollide then
					part.CanCollide = false
				end
			end
			
			-- បើក Fly (ហោះជាប់រហូត)
			enableFly(hrp)
		else
			disableFly()
		end
	else
		disableFly()
	end
end)


-- ==========================================
-- ៣. កូដ Auto-Farm / Dynamic Ground Level Tween
-- ==========================================
task.spawn(function()
	local character = player.Character or player.CharacterAdded:Wait()
	local hrp = character:WaitForChild("HumanoidRootPart")

	local areaEggSlotsClient = Workspace:WaitForChild("AreaEggSlotsClient")
	local objects = Workspace:WaitForChild("__OBJECTS", 5)
	local areas = objects and objects:WaitForChild("Areas", 5)
	local guardAreas = areas and areas:WaitForChild("GuardAreas", 5)

	local SPEED = 300            
	local HEIGHT_OFFSET = 3.5    -- កម្ពស់បន្ថែមពីលើ surface ដី
	local MAX_PROXIMITY_DIST = 20 
	local WAIT_AT_BASE = 1       

	local originalCFrame = CFrame.new(
		502.072418, 70.8011246, -366.667084,
		0.00921290647, -8.88573126e-08, -0.999957561,
		2.34353532e-08, 1, -8.8645173e-08,
		0.999957561, -2.26176802e-08, 0.00921290647
	)

	local function getGroundYForPosition(targetPosition)
		local closestY = targetPosition.Y 
		local shortestDistance = math.huge

		if guardAreas then
			for _, part in ipairs(guardAreas:GetChildren()) do
				if part:IsA("BasePart") then
					local dist = (Vector2.new(part.Position.X, part.Position.Z) - Vector2.new(targetPosition.X, targetPosition.Z)).Magnitude
					if dist < shortestDistance then
						shortestDistance = dist
						closestY = part.Position.Y + (part.Size.Y / 2)
					end
				end
			end
		end

		return closestY
	end

	local function getTweenInfo(startCFrame, targetCFrame)
		local dist = (startCFrame.Position - targetCFrame.Position).Magnitude
		local duration = dist / SPEED
		return TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	end

	local function interactNearbyPrompts()
		if not getgenv().AutoInteract then return end
		
		local currentPos = hrp.Position
		for _, prompt in ipairs(Workspace:GetDescendants()) do
			if prompt:IsA("ProximityPrompt") and prompt.Enabled then
				local parentPart = prompt.Parent
				if parentPart and parentPart:IsA("BasePart") then
					local dist = (parentPart.Position - currentPos).Magnitude
					if dist <= MAX_PROXIMITY_DIST then
						fireproximityprompt(prompt)
					end
				end
			end
		end
	end

	while true do
		if getgenv().AutoInteract then
			for _, slot in ipairs(areaEggSlotsClient:GetChildren()) do
				if not getgenv().AutoInteract then break end
				
				local hitbox = slot:FindFirstChild("Hitbox", true)
				if hitbox and hitbox:IsA("BasePart") then
					
					local targetPos = hitbox.Position
					local groundY = getGroundYForPosition(targetPos)
					local dynamicTargetY = groundY + HEIGHT_OFFSET
					
					local targetCFrame = CFrame.new(targetPos.X, dynamicTargetY, targetPos.Z) * hitbox.CFrame.Rotation
					
					local tweenToInfo = getTweenInfo(hrp.CFrame, targetCFrame)
					local tweenTo = TweenService:Create(hrp, tweenToInfo, {CFrame = targetCFrame})
					tweenTo:Play()
					tweenTo.Completed:Wait()
					
					task.wait(0.9)
					interactNearbyPrompts()

					local tweenBackInfo = getTweenInfo(hrp.CFrame, originalCFrame)
					local tweenBack = TweenService:Create(hrp, tweenBackInfo, {CFrame = originalCFrame})
					tweenBack:Play()
					tweenBack.Completed:Wait()
					
					task.wait(WAIT_AT_BASE)
				end
			end
		end
		task.wait(0.5)
	end
end)



