            hum:Move(Vector3.zero)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            return true
        end

        local walkSpeed = (hum.WalkSpeed and hum.WalkSpeed > 0) and hum.WalkSpeed or 25
        local duration = distance / walkSpeed
        local lookCFrame = CFrame.lookAt(hrp.Position, exactPos)
        hrp.CFrame = lookCFrame
        local targetCFrame = CFrame.new(exactPos) * lookCFrame.Rotation
        
        local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Linear)
        local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
        local direction = (exactPos - hrp.Position).Unit
        local animConn

        animConn = RunService.Heartbeat:Connect(function()
            if not hum or hum.Health <= 0 or not hrp or not hrp.Parent then
                tween:Cancel()
                if animConn then animConn:Disconnect() end
                return
            end
            hum:Move(direction)
            hrp.AssemblyLinearVelocity = direction * walkSpeed
        end)
        
        tween:Play()
        tween.Completed:Wait()
        
        if animConn then animConn:Disconnect() end
        
        if hum and hum.Health > 0 and hrp and hrp.Parent then
            hum:Move(Vector3.zero)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
        return true
    end

    local function getTargetEgg()
    local slots = areaEggSlotsClient:GetChildren()
    
    if getgenv().AutoRainbowEgg then
        local bestEgg = nil
        local bestPriority = 99
        local shortestDistance = math.huge
        local hrp = getHRP()
        local hrpPos = hrp and hrp.Position or Vector3.zero
        
        -- ស្កេនមើលស៊ុតទាំងអស់ក្នុង Area
        for _, slot in ipairs(slots) do
            local priority = checkEggPriority(slot)
            
            if priority < 99 then -- ប្រសិនបើវាជា Devine, Eternal, ឬ Secret
                local hitbox = slot:FindFirstChild("Hitbox", true) or (slot:IsA("BasePart") and slot) or slot:FindFirstChildWhichIsA("BasePart", true)
                local dist = hitbox and (hitbox.Position - hrpPos).Magnitude or math.huge

                -- លក្ខខណ្ឌទី១៖ បើ Priority ល្អជាង (ឧទាហរណ៍ 1 ល្អជាង 3) យកវាតែម្តង មិនខ្វល់ចម្ងាយ!
                if priority < bestPriority then
                    bestPriority = priority
                    shortestDistance = dist
                    bestEgg = slot
                -- លក្ខខណ្ឌទី២៖ បើ Priority ស្មើគ្នា (ឧទាហរណ៍ Devine ២គ្រាប់) ទើបវារើសយកអាណាដែលជិតជាង!
                elseif priority == bestPriority and dist < shortestDistance then
                    shortestDistance = dist
                    bestEgg = slot
                end
            end
        end
        
        -- បើរកឃើញស៊ុតពិសេស គឺបញ្ជាឲ្យទៅលួចភ្លាម
        if bestEgg then
            return bestEgg
        end
    end

        if getgenv().AutoPartFarm then
            local bestPartEgg = nil
            local maxParts = -1
            for _, slot in ipairs(slots) do
                local partsCount = countParts(slot)
                if partsCount >= Config.Farm.MinPartsCount and partsCount > maxParts then
                    maxParts = partsCount
                    bestPartEgg = slot
                end
            end
            if bestPartEgg then return bestPartEgg end
        end

        if getgenv().AutoBigEgg then
            local bestBigEgg = nil
            local maxVolume = -1
            for _, slot in ipairs(slots) do
                local volume = getEggSize(slot)
                if volume >= 90 and volume > maxVolume then
                    maxVolume = volume
                    bestBigEgg = slot
                end
            end
            if bestBigEgg then return bestBigEgg end
        end

        if getgenv().AutoInteract then
            for _, slot in ipairs(slots) do
                local hitbox = slot:FindFirstChild("Hitbox", true)
                if hitbox and hitbox:IsA("BasePart") and isHitboxInAllowedArea(hitbox) then
                    return slot
                end
            end
        end
        return nil
    end

    local cachedMyPlot = nil
    local function findMyPlot()
        if cachedMyPlot and cachedMyPlot.Parent then return cachedMyPlot end
        local plotsFolder = workspace:FindFirstChild("Plots")
        if not plotsFolder then return nil end

        for _, plot in ipairs(plotsFolder:GetChildren()) do
            if plot.Name == player.Name or plot.Name == tostring(player.UserId) then
                cachedMyPlot = plot
                return plot
            end
            for attrName, attrValue in pairs(plot:GetAttributes()) do
                local strVal = tostring(attrValue)
                if strVal == player.Name or strVal == player.DisplayName or strVal == tostring(player.UserId) then
                    cachedMyPlot = plot
                    return plot
                end
            end
            for _, descendant in ipairs(plot:GetDescendants()) do
                if (descendant:IsA("TextLabel") or descendant:IsA("TextButton")) and (string.find(descendant.Text, player.Name) or string.find(descendant.Text, player.DisplayName)) then
                    cachedMyPlot = plot
                    return plot
                elseif descendant:IsA("StringValue") and (descendant.Value == player.Name or descendant.Value == player.DisplayName) then
                    cachedMyPlot = plot
                    return plot
                elseif descendant:IsA("ObjectValue") and descendant.Value == player then
                    cachedMyPlot = plot
                    return plot
                elseif (descendant:IsA("IntValue") or descendant:IsA("NumberValue")) and descendant.Value == player.UserId then
                    cachedMyPlot = plot
                    return plot
                end
            end
        end
        return nil
    end

    local function teleportToTreadmillRoot()
        local myPlot = findMyPlot()
        if not myPlot then return false end
        local plotNumber = string.match(myPlot.Name, "%d+")
        local treadmillFolder = workspace:FindFirstChild("__ClientTreadmillRenders")
        if not plotNumber or not treadmillFolder then return false end

        local myTreadmill = treadmillFolder:FindFirstChild("TreadmillRender_" .. plotNumber)
        if myTreadmill then
            local rootPart = myTreadmill:FindFirstChild("Root", true)
            local targetCFrame
            if rootPart and rootPart:IsA("BasePart") then
                targetCFrame = rootPart.CFrame
            else
                targetCFrame = myTreadmill:IsA("Model") and myTreadmill:GetPivot() or (myTreadmill:IsA("BasePart") and myTreadmill.CFrame)
            end

            if targetCFrame then
                local hrp = getHRP()
                if not hrp then return false end
                
                local finalCFrame = targetCFrame * CFrame.new(0, Config.Farm.TreadmillHipOffset or 3, 0)
                hrp.CFrame = finalCFrame
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                return true
            end
        end
        return false
    end

    local function tweenToTreadmillRoot()
    local myPlot = findMyPlot()
    if not myPlot then return false end

    local plotNumber = string.match(myPlot.Name, "%d+")
    local treadmillFolder = workspace:FindFirstChild("__ClientTreadmillRenders")
    if not plotNumber or not treadmillFolder then return false end

    local myTreadmill = treadmillFolder:FindFirstChild("TreadmillRender_" .. plotNumber)
    if myTreadmill then
        local rootPart = myTreadmill:FindFirstChild("Root", true)
        local targetCFrame
        
        if rootPart and rootPart:IsA("BasePart") then
            targetCFrame = rootPart.CFrame
        else
            targetCFrame = myTreadmill:IsA("Model") and myTreadmill:GetPivot() or (myTreadmill:IsA("BasePart") and myTreadmill.CFrame)
        end

        if targetCFrame then
            local hrp = getHRP()
            if not hrp then return false end

            -- កំណត់ទីតាំងគោលដៅ
            local finalCFrame = targetCFrame * CFrame.new(0, Config.Farm.TreadmillHipOffset, 0)
            lastTreadmillTargetCF = finalCFrame -- រក្សាទុកកូអរដោណេដើម្បីការពារការគាំង Script ផ្សេង

            -- បញ្ជាឲ្យ Teleport (CFrame) ទៅតែម្តង (លុបកូដ Tween ចោល)
            hrp.CFrame = finalCFrame
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            
            -- ដាក់ Delay បន្តិច (0.2 វិនាទី) មុននឹងបញ្ជូន Remote ទៅ Server ដើម្បីការពារកុំឲ្យលោត Error ក្រហម (Readonly table)
            task.wait(0.2) 

            return true
        end
    end
    return false
end

    local function stealEggAtLocation(hitbox)
        local char = player.Character
        local hum = char and char:FindFirstChild("Humanoid")
        local hrp = getHRP()
        local basePos = originalCFrame.Position
        
        if not hrp or not hitbox or not hum then return end

        pcall(function()
            local portal = workspace:FindFirstChild("ScrambleArenaPortal")
            if portal then
                if portal:IsA("BasePart") then portal.CanCollide = false end
                for _, part in ipairs(portal:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end)

        hrp.Anchored = false
        hum.PlatformStand = false
        
        hrp.CFrame = CFrame.new(basePos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        task.wait(0.2)
        
        local eggName = hitbox.Parent.Name
        if eggName == "AreaEggSlotsClient" or eggName == "Workspace" then
            eggName = hitbox.Name
        end

        runToExactPosition(hum, hrp, hitbox)

        local loopCount = 0
        local maxTime = 150
        local initialHum = hum

        while loopCount < maxTime do
            task.wait(0.5)
            loopCount = loopCount + 1

            if not isWallOpenOrCountdownFinished() then break end

            local currentChar = player.Character
            if not currentChar then 
                getgenv().IsDoingEgg = false
                break 
            end
            
            local currentHum = currentChar:FindFirstChild("Humanoid")
            local currentHrp = currentChar:FindFirstChild("HumanoidRootPart")

            if not currentHum or currentHum.Health <= 0 or not currentHrp or currentHum ~= initialHum then 
                getgenv().IsDoingEgg = false
                break 
            end
            
            char = currentChar
            hum = currentHum
            hrp = currentHrp

            local eggInArea = Workspace:FindFirstChild("AreaEggSlotsClient") and Workspace.AreaEggSlotsClient:FindFirstChild(eggName)
            local eggInWorkspace = Workspace:FindFirstChild(eggName)
            local eggInChar = char:FindFirstChild(eggName, true)

            if not eggInArea and not eggInWorkspace and not eggInChar then break end

            if eggInArea then
                local targetPart = eggInArea:IsA("BasePart") and eggInArea or eggInArea:FindFirstChild("Hitbox", true) or eggInArea:FindFirstChildWhichIsA("BasePart", true)
                if targetPart then
                    if (hrp.Position - targetPart.Position).Magnitude > 3 then
                        runToExactPosition(hum, hrp, targetPart)
                    end
                    firePromptsInRadius(1)
                end
            elseif eggInWorkspace or eggInChar then
                local actualEgg = eggInChar or eggInWorkspace
                local targetPart = actualEgg:IsA("BasePart") and actualEgg or actualEgg:FindFirstChild("Hitbox", true) or actualEgg:FindFirstChildWhichIsA("BasePart", true)
                if targetPart then
                    local distToEgg = (hrp.Position - targetPart.Position).Magnitude
                    if eggInChar or distToEgg <= 30 then
                        local distToBase = (hrp.Position - basePos).Magnitude
                        if distToBase > 3 then
                            local dropCFrame = CFrame.new(960.46814, 70.2761765, -411.626953, -0.125948429, -9.17669709e-08, -0.992036819, -2.63757052e-08, 1, -8.91549519e-08, 0.992036819, 1.49367452e-08, -0.125948429)
                            hrp.CFrame = dropCFrame
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                            task.wait(0.5)
                            
                            pcall(function()
                                local ReplicatedStorage = game:GetService("ReplicatedStorage")
                                local AreaEggs = require(ReplicatedStorage.Shared.Types.AreaEggs)
                                local EggState = require(ReplicatedStorage.Client.EggState)
                                local PlayerRequest = AreaEggs.DropReasons.PlayerRequest
                                EggState.DropFieldEgg(PlayerRequest)
                            end)
                            task.wait(0.5)
                            if typeof(basePos) == "Vector3" then hrp.CFrame = CFrame.new(basePos)
                            else hrp.CFrame = basePos.CFrame or basePos end
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                            task.wait(0.3)
                            

                            teleportToTreadmillRoot()
                            task.wait(0.5)

                            local repStorage = game:GetService("ReplicatedStorage")
                            local networking = repStorage:FindFirstChild("Packages") and repStorage.Packages:FindFirstChild("Networking")
                            local askWearStillRemote = networking and networking:FindFirstChild("RF/Treadmill/AskWearStill")
                            local askDoffRemote = networking and networking:FindFirstChild("RF/Treadmill/AskDoff")

                            if askWearStillRemote then
                                for attempt = 1, 3 do
                                    local success, response = pcall(function() return askWearStillRemote:InvokeServer() end)
                                    if success and response then break end
                                    task.wait(0.2)
                                end
                            end
                            task.wait(0.6)

                            if askDoffRemote then
                                for attempt = 1, 3 do
                                    local success = pcall(function() return askDoffRemote:InvokeServer() end)
                                    if success then break end
                                    task.wait(0.2)
                                end
                            end
                            task.wait(0.5)

                            if typeof(basePos) == "Vector3" then hrp.CFrame = CFrame.new(basePos)
                            else hrp.CFrame = basePos.CFrame or basePos end
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                            task.wait(0.3)
                            
                            hrp.CFrame = dropCFrame
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                            task.wait(0.2)
                            
                            
                            for i = 1, 6 do
                            firePromptsInRadius(20)
                            task.wait(0.05) -- រង់ចាំ 0.05 វិនាទីមុននឹង Fire ម្តងទៀត
                            end

                            if typeof(basePos) == "Vector3" then hrp.CFrame = CFrame.new(basePos)
                            else hrp.CFrame = basePos.CFrame or basePos end
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                            task.wait(2)
                            break
                        else
                            task.wait(0.3)
                            firePromptsInRadius(20)
                        end
                    else
                        if typeof(targetPart) == "Vector3" then hrp.CFrame = CFrame.new(targetPart)
                        else hrp.CFrame = targetPart.CFrame end
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                        task.wait(0.3)
                        firePromptsInRadius(20)
                    end
                else
                    if typeof(basePos) == "Vector3" then hrp.CFrame = CFrame.new(basePos)
                    else hrp.CFrame = basePos.CFrame or basePos end
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end
        
        pcall(function()
            local portal = workspace:FindFirstChild("ScrambleArenaPortal")
            if portal then
                if portal:IsA("BasePart") then portal.CanCollide = true end
                for _, part in ipairs(portal:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = true end
                end
            end
        end)
        
        task.wait(Config.Farm.WaitAtBase)
    end

    local function leaveTreadmill()
        local askDoffRemote = nil
        pcall(function()
            askDoffRemote = ReplicatedStorage.Packages.Networking:FindFirstChild("RF/Treadmill/AskDoff")
        end)
        if askDoffRemote and askDoffRemote:IsA("RemoteFunction") then
            pcall(function() askDoffRemote:InvokeServer() end)
        end
        local hrp = getHRP()
        if hrp then hrp.Anchored = false end
    end

local hasMovedToBase = false
local wasEventActive = false
local wasMapResetting = false -- អថេរថ្មីសម្រាប់ចាំមើលការផ្លាស់ប្តូរពេលយប់ ឬ Map Reset

while true do
    task.wait(0.1)
    pcall(function()
        local char = player.Character
        local hum = char and char:FindFirstChild("Humanoid")
        if not char or not hum or hum.Health <= 0 or not char:FindFirstChild("HumanoidRootPart") then
            getgenv().IsDoingEgg = false
            isCurrentlyOnTreadmill = false
            hasMovedToBase = false
            return -- ផ្អាកត្រឹមនេះសិន ដើម្បីកុំឲ្យមានការរង់ចាំ
        end

        local arena = workspace:FindFirstChild("ScrambleArena")
        local portal = workspace:FindFirstChild("ScrambleArenaPortal")
        local isEventActive = (portal ~= nil or arena ~= nil)

        -- [១] ពេលចប់ Event (បាត់ Portal) រង់ចាំ ៣ វិនាទី រួច Teleport ទៅម៉ាស៊ីនរត់
        if wasEventActive and not isEventActive then
            task.wait(3)
            if getgenv().AutoTreadmill then
                local success = teleportToTreadmillRoot()
                if success then
                    isCurrentlyOnTreadmill = true
                    task.wait(1)
                end
            end
        end
        wasEventActive = isEventActive

        -- ឆែកមើលពេលយប់ (ClockTime ចន្លោះម៉ោង 18:00 ល្ងាច ដល់ 6:30 ព្រឹក)
        local isNight = (Lighting.ClockTime > 17.5 or Lighting.ClockTime < 6.5)
        local isWallOpen = isWallOpenOrCountdownFinished()
        
        -- កំណត់ថា Map រួចរាល់ លុះត្រាតែជញ្ជាំងបើក ហើយមិនមែនជាពេលយប់
        local isMapReady = isWallOpen and not isNight

        if isMapReady then
            -- [ចំណុចបន្ថែម] បើទើបតែភ្លឺ ឬ Map ទើបតែ Reset រួច ឲ្យវាចាំ ៣ វិនាទីសិន!
            if wasMapResetting then
                wasMapResetting = false
                task.wait(3) -- រង់ចាំ 3 វិនាទី តាមការស្នើសុំ
            end

            hasMovedToBase = false
            local targetSlot = getTargetEgg()
            
            if targetSlot then
                getgenv().IsDoingEgg = true
                local hitbox = targetSlot:FindFirstChild("Hitbox", true) or (targetSlot:IsA("BasePart") and targetSlot) or targetSlot:FindFirstChildWhichIsA("BasePart", true)
                
                if hitbox then
                    if isCurrentlyOnTreadmill then
                        leaveTreadmill()
                        isCurrentlyOnTreadmill = false
                        local hrp = getHRP()
                        if hrp then
                            hrp.Anchored = false
                            hrp.AssemblyLinearVelocity = Vector3.zero
                        end
                        task.wait(0.5)
                    end
                    stealEggAtLocation(hitbox)
                end
            else
                getgenv().IsDoingEgg = false
                if getgenv().AutoFarmEvent and isEventActive then
                    if isCurrentlyOnTreadmill then
                        leaveTreadmill()
                        isCurrentlyOnTreadmill = false
                        task.wait(0.5)
                    end
                elseif getgenv().AutoTreadmill then
                    local hrp = getHRP()
                    if isCurrentlyOnTreadmill and hrp and lastTreadmillTargetCF then
                        local dist = (hrp.Position - lastTreadmillTargetCF.Position).Magnitude
                        if dist > Config.Farm.TreadmillMaxDistance then
                            isCurrentlyOnTreadmill = false
                        end
                    end
                    if not isCurrentlyOnTreadmill then
                        local success = tweenToTreadmillRoot()
                        if success then isCurrentlyOnTreadmill = true end
                    end
                else
                    if isCurrentlyOnTreadmill then
                        leaveTreadmill()
                        isCurrentlyOnTreadmill = false
                    end
                end
            end
        else
            -- ==========================================
            -- ពេលយប់ ឬ ពេល Map កំពុង Reset វានឹងធ្លាក់ចូលទីនេះ
            -- ==========================================
            if not wasMapResetting then
                wasMapResetting = true
            end

            getgenv().IsDoingEgg = false

            -- បញ្ឈប់ការរត់ទៅ Base ពេលកំពុងវ៉ៃមេ (បង្កកវានៅនឹងកន្លែង Area Event)
            if getgenv().AutoFarmEvent and isEventActive then
                hasMovedToBase = true
                if hum then hum:Move(Vector3.zero) end
            elseif not hasMovedToBase then
                
                -- [ចំណុចបន្ថែម] ផ្តាច់ខ្លួនពីម៉ាស៊ីនរត់ភ្លាមៗពេលយប់
                if isCurrentlyOnTreadmill then
                    leaveTreadmill()
                    isCurrentlyOnTreadmill = false
                    task.wait(0.5)
                end
                
                local hrp = getHRP()
                if hrp and hum then
                    local basePos = originalCFrame.Position
                    local distToBase = (hrp.Position - basePos).Magnitude
                    
                    -- រត់មកឈរចាំនៅ Base
                    if distToBase > 5 then
                        hum:Move(Vector3.zero)
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                        runToExactPosition(hum, hrp, basePos)
                        if hrp then hrp.CFrame = originalCFrame end
                    else
                        if hrp then hrp.CFrame = originalCFrame end
                    end
                end
                hasMovedToBase = true
            else
                if hum then hum:Move(Vector3.zero) end
            end
        end
    end)
end
