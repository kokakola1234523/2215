task.spawn(function()
    task.wait(1)
    local hrp = getHRP()
    if not hrp then return end
    local objects = workspace:FindFirstChild("__OBJECTS")
    local areas = objects and objects:FindFirstChild("Areas")
    local guardAreas = areas and areas:FindFirstChild("GuardAreas")
    
    local targetCFrame = CFrame.new(538.479553, 70.8011246, -409.704681, 0.730235636, 8.46091197e-08, -0.683195353, -5.78969193e-08, 1, 6.19599163e-08, 0.683195353, -5.69043168e-09, 0.730235636)

    local function getGuardAreaGroundY(currentPos)
        local groundY = currentPos.Y
        local shortestDist = math.huge
        if guardAreas then
            for _, part in ipairs(guardAreas:GetChildren()) do
                local basePart = part:IsA("BasePart") and part or (part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart", true))
                if basePart then
                    local dist = (Vector2.new(basePart.Position.X, basePart.Position.Z) - Vector2.new(currentPos.X, currentPos.Z)).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        groundY = basePart.Position.Y + (basePart.Size.Y / 2)
                    end
                end
            end
        end
        return groundY
    end

    local tweenTime = 2
    local tweenInfo = TweenInfo.new(tweenTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local currentPos = hrp.Position
    local groundY = getGuardAreaGroundY(currentPos)
    local targetFlyY = groundY + 60
    local highStartCF = CFrame.new(currentPos.X, targetFlyY, currentPos.Z) * hrp.CFrame.Rotation

    local tweenUp = TweenService:Create(hrp, tweenInfo, {CFrame = highStartCF})
    tweenUp:Play()
    tweenUp.Completed:Wait()

    local tweenToTarget = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    tweenToTarget:Play()

    window:Notify({
        title = "---ប្រព័ន្ធដំណើរការហើយ---",
        content = "អាចប្រើប្រាស់បានហើយ",
        duration = 5,
    })

    task.wait(1)
    window:Notify({
        title = "---ការនែនាំ---",
        content = "កុំExecute Script ពីរដងជាប់គ្នារ\nចុចតែម្តងបានហើយមិនចឹងទេវាទាញចុះឡើងដំណើរការមិនស្រួស\nប្រសិនជួបករណីនឹងClear Gameចូលម្តងទៀត",
        duration = 5,
    })
end)
