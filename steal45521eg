-- ៤. កូដ Auto-Farm (ហោះលើ Map កម្ពស់ ២០ Studs ថេរ)
-- ==========================================
task.spawn(function()
    local char = player.Character or player.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart")

    local areaEggSlotsClient = Workspace:WaitForChild("AreaEggSlotsClient")
    local objects = Workspace:WaitForChild("__OBJECTS", 5)
    local areas = objects and objects:WaitForChild("Areas", 5)
    local guardAreas = areas and areas:WaitForChild("GuardAreas", 5)

    local SPEED = 550             
    local FLY_OFFSET_HEIGHT = 35  -- កម្ពស់ហោះថេរលើដី Map (+20 Studs)
    local HEIGHT_OFFSET = 3.5    -- កម្ពស់បន្ថែមលើដីពេលចុះទៅយក Egg
    local MAX_PROXIMITY_DIST = 5 
    local WAIT_AT_BASE = 1       

    local originalCFrame = CFrame.new(
        540.517273, 70.5475159, -364.945435, 0.0517056733, 5.14744904e-08, 
        -0.998662353, -5.42448539e-08, 1, 4.87349148e-08, 
        0.998662353, 5.1652421e-08, 0.0517056733
    )

    -- គណនាកម្ពស់ដី GuardAreas
    local function getGroundYForPosition(targetPosition)
        local closestY = targetPosition.Y
        local shortestDistance = math.huge

        if guardAreas then
            for _, part in ipairs(guardAreas:GetChildren()) do
                local basePart = part:IsA("BasePart") and part or (part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart", true))
                if basePart then
                    local dist = (Vector2.new(basePart.Position.X, basePart.Position.Z) - Vector2.new(targetPosition.X, targetPosition.Z)).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        closestY = basePart.Position.Y + (basePart.Size.Y / 2)
                    end
                end
            end
        end
        return closestY
    end

    local function isHitboxInAllowedArea(hitbox)
        if not hitbox then return false end
        local hitboxPos = hitbox.Position

        for _, name in ipairs(selectedModules) do
            local areaObj = guardAreas and guardAreas:FindFirstChild(name)
            if areaObj then
                local areaPart = areaObj:IsA("BasePart") and areaObj or (areaObj.PrimaryPart or areaObj:FindFirstChildWhichIsA("BasePart", true))
                if areaPart then
                    local dist = (Vector2.new(hitboxPos.X, hitboxPos.Z) - Vector2.new(areaPart.Position.X, areaPart.Position.Z)).Magnitude
                    if dist <= 150 then 
                        return true
                    end
                end
            end
        end
        return false
    end

    local function getTweenInfo(startCF, targetCF)
        local dist = (startCF.Position - targetCF.Position).Magnitude
        local duration = dist / SPEED
        return TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    end

    local function interactNearbyPrompts(isBigEggMode)
        local activeCheck = isBigEggMode and getgenv().AutoBigEgg or getgenv().AutoInteract
        if not activeCheck then return end
        
        local currentPos = hrp.Position
        for _, prompt in ipairs(Workspace:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") and prompt.Enabled then
                local parentPart = prompt.Parent
                if parentPart and parentPart:IsA("BasePart") then
                    if (parentPart.Position - currentPos).Magnitude <= MAX_PROXIMITY_DIST then
                        fireproximityprompt(prompt)
                    end
                end
            end
        end
    end

    local function stealEggAtLocation(hitbox, isBigEggMode)
        local targetPos = hitbox.Position
        local groundY = getGroundYForPosition(targetPos)
        
        -- គណនាកម្ពស់ Safe Flight (+20 លើកម្ពស់ដី GuardAreas)
        local flyY = groundY + FLY_OFFSET_HEIGHT
        local collectTargetCF = CFrame.new(targetPos.X, groundY + HEIGHT_OFFSET, targetPos.Z) * hitbox.CFrame.Rotation

        -- 1. ឡើងទៅកម្ពស់ Safe Flight (GroundY + 20)
        local currentGroundY = getGroundYForPosition(hrp.Position)
        local startFlyY = math.max(hrp.Position.Y, currentGroundY + FLY_OFFSET_HEIGHT)
        local highStartCF = CFrame.new(hrp.Position.X, startFlyY, hrp.Position.Z) * hrp.CFrame.Rotation
        
        local tweenUp = TweenService:Create(hrp, getTweenInfo(hrp.CFrame, highStartCF), {CFrame = highStartCF})
        tweenUp:Play()
        tweenUp.Completed:Wait()

        -- 2. ហោះកម្ពស់ +20 លើ Map ទៅកាន់ចំណុចខាងលើ Egg
        local highTargetCF = CFrame.new(targetPos.X, flyY, targetPos.Z) * hitbox.CFrame.Rotation
        local tweenFlyTo = TweenService:Create(hrp, getTweenInfo(hrp.CFrame, highTargetCF), {CFrame = highTargetCF})
        tweenFlyTo:Play()
        tweenFlyTo.Completed:Wait()

        -- 3. ចុះមកក្រោមយក Egg (ចុះមកកម្ពស់ GroundY + 3.5)
        local tweenDownToEgg = TweenService:Create(hrp, getTweenInfo(hrp.CFrame, collectTargetCF), {CFrame = collectTargetCF})
        tweenDownToEgg:Play()
        tweenDownToEgg.Completed:Wait()

        -- 4. ចុចយក Egg
        task.wait(0.5)
        interactNearbyPrompts(isBigEggMode)
        task.wait(0.4)

        -- 5. ឡើងត្រឡប់ទៅកម្ពស់ +20 លើអាកាសវិញ
        local tweenBackUp = TweenService:Create(hrp, getTweenInfo(hrp.CFrame, highTargetCF), {CFrame = highTargetCF})
        tweenBackUp:Play()
        tweenBackUp.Completed:Wait()

        -- 6. ហោះលើអាកាសត្រឡប់មកចំណុចខាងលើ Base
        local baseGroundY = getGroundYForPosition(originalCFrame.Position)
        local highBaseCF = CFrame.new(originalCFrame.Position.X, baseGroundY + FLY_OFFSET_HEIGHT, originalCFrame.Position.Z) * originalCFrame.Rotation
        local tweenFlyBack = TweenService:Create(hrp, getTweenInfo(hrp.CFrame, highBaseCF), {CFrame = highBaseCF})
        tweenFlyBack:Play()
        tweenFlyBack.Completed:Wait()

        -- 7. ចុះមកទីតាំង Base ដើម
        local tweenLanding = TweenService:Create(hrp, getTweenInfo(hrp.CFrame, originalCFrame), {CFrame = originalCFrame})
        tweenLanding:Play()
        tweenLanding.Completed:Wait()

        task.wait(WAIT_AT_BASE)
    end

    while true do
        -- វិធីទី ១៖ លួចតាម Dropdown
        if getgenv().AutoInteract then
            for _, slot in ipairs(areaEggSlotsClient:GetChildren()) do
                if not getgenv().AutoInteract then break end
                
                local hitbox = slot:FindFirstChild("Hitbox", true)
                if hitbox and hitbox:IsA("BasePart") and isHitboxInAllowedArea(hitbox) then
                    stealEggAtLocation(hitbox, false)
                end
            end
        end

        -- វិធីទី ២៖ លួចតែស៊ុតធំៗ (Big Eggs Only)
        if getgenv().AutoBigEgg then
            local slots = areaEggSlotsClient:GetChildren()
            local bestSlot = nil
            local maxVolume = -1

            for _, slot in ipairs(slots) do
                local volume = getEggSize(slot)
                if volume >= 90 and volume > maxVolume then
                    maxVolume = volume
                    bestSlot = slot
                end
            end

            if bestSlot then
                local hitbox = bestSlot:FindFirstChild("Hitbox", true) or (bestSlot:IsA("BasePart") and bestSlot or bestSlot:FindFirstChildWhichIsA("BasePart", true))
                if hitbox then
                    stealEggAtLocation(hitbox, true)
                end
            else
                task.wait(0.5)
            end
        end

        task.wait(0.1)
    end
end)

