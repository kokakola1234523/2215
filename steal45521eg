    function runToExactPosition(hum, hrp, target)
    if not hrp or not hum then return false end

    local walkSpeed = (hum.WalkSpeed and hum.WalkSpeed > 0) and hum.WalkSpeed or 25
    hum.WalkSpeed = walkSpeed

    local targetPos = typeof(target) == "Vector3" and target or target.Position
    local exactPos = Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z)
    
