local function Tween(obj, props, time)
    local tweenInfo = TweenInfo.new(time or 0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local t = TweenService:Create(obj, tweenInfo, props)
    t:Play()
    return t
end

