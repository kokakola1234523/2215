local function isWallOpenOrCountdownFinished()
    -- យើងលុបការឆែក PlayerGui ចោល ព្រោះវា Glitch ពេលតួអង្គកើតមកវិញ
    -- ឲ្យវាឆែកមើលតែជញ្ជាំងពិតប្រាកដនៅក្នុង Workspace វិញ ទើបច្បាស់ ១០០%
    local resetWall = Workspace:FindFirstChild("AreaEggResetWall") or Workspace:FindFirstChild("EggResetWall")
    if resetWall then
        local wallPart = resetWall:IsA("BasePart") and resetWall or resetWall:FindFirstChildWhichIsA("BasePart", true)
        -- បើជញ្ជាំងនៅបាំង (CanCollide = true) មានន័យថាមិនទាន់បើកទេ
        if wallPart and wallPart.Transparency < 1 and wallPart.CanCollide then
            return false
        end
    end
    -- បើគ្មានជញ្ជាំង ឬជញ្ជាំងអត់បាំងទេ គឺបើកហើយ
    return true
end

local function checkEggPriority(slot)
    if not slot or not slot.Name then return 99 end
    local hasDecal = false
    local hasFXStars = false
    local hasAttachment = false

    local function scanName(str)
        local s = string.lower(str)
        if string.find(s, "decal") or string.find(s, "fx") then hasDecal = true end
        if string.find(s, "fx")  then hasFXStars = true end
        if string.find(s, "attachment") then hasAttachment = true end
    end

    -- ស្កេនឈ្មោះស៊ុត និងវត្ថុទាំងអស់ខាងក្នុង
    scanName(slot.Name)
    for _, item in ipairs(slot:GetDescendants()) do
        if item and item.Name then scanName(item.Name) end
    end

    -- កំណត់លក្ខណៈសម្បត្តិនៃស៊ុតនីមួយៗ
    local isDevine = hasFXStars and hasDecal
    local isEternal = hasFXStars and not hasDecal
    local isSecret = hasAttachment and not hasFXStars

    -- ឆែកមើលថាតើប្រភេទស៊ុតនេះមាននៅក្នុងបញ្ជីដែលបានរើសក្នុង Dropdown ដែរឬទេ
    if isDevine and table.find(getgenv().SelectedSpecialEggs, "Devine") then
        return 1 -- Devine (អាទិភាពទី១ ដាច់ខាត)
    elseif isEternal and table.find(getgenv().SelectedSpecialEggs, "Eternal") then
        return 2 -- Eternal (អាទិភាពទី២)
    elseif isSecret and table.find(getgenv().SelectedSpecialEggs, "Secret") then
        return 3 -- Secret (អាទិភាពទី៣)
    end

    return 99
end
