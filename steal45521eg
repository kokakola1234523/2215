local function getBestTool(player, character)
    local backpack = player:FindFirstChild("Backpack")
    if not character then return nil end
    for _, item in ipairs(character:GetChildren()) do
        if item:IsA("Tool") and item:FindFirstChild("Controller") then return item end
    end
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and item:FindFirstChild("Controller") then return item end
        end
    end
    local fallback = character:FindFirstChild("Bat [X1]") or (backpack and backpack:FindFirstChild("Bat [X1]"))
    if fallback then return fallback end
    return character:FindFirstChildOfClass("Tool") or (backpack and backpack:FindFirstChildOfClass("Tool"))
end

local function isMechAttacking(arena)
    if not arena then return false end
    local mech = arena:FindFirstChild("Mech")
    if mech then
        for _, obj in ipairs(mech:GetDescendants()) do
            if obj:IsA("Highlight") and obj.Name ~= "HitFlash" and obj.Enabled then
                local r = math.floor(obj.OutlineColor.R * 255 + 0.5)
                local g = math.floor(obj.OutlineColor.G * 255 + 0.5)
                local b = math.floor(obj.OutlineColor.B * 255 + 0.5)
                if r == 255 and g == 45 and b == 45 then return true end
            end
        end
    end
    local badParts = {"Warning", "Attack", "Danger", "AttackArea"}
    for _, name in ipairs(badParts) do
        if arena:FindFirstChild(name) then return true end
    end
    return false
end

