local function sellHeldEgg()
    if not (Network and Constants) then return end
    local char = player.Character
    if not char then return end
    
    local tool = char:FindFirstChildWhichIsA("Tool")
    if tool then
        local itemType = tool:GetAttribute("ItemType")
        if itemType == "AssetEgg" or itemType == "PetEgg" then
            local eggUID = tool:GetAttribute("UID")
            if eggUID then
                Network.Fire(Constants.NETWORK_MAP.AssetInventory.SELL_ASSET, { eggUID })
            end
        end
    end
end

local function clickAllExistingItems()
    local items = scrollingFrame:GetChildren()

    for index, itemFrame in ipairs(items) do
        if not isAutoSellEnabled then break end

        if itemFrame:IsA("GuiObject") and itemFrame.Name ~= "UIGridLayout" and itemFrame.Name ~= "UIListLayout" and itemFrame.Name ~= "UIPadding" and itemFrame.Name ~= "Template" then
            pcall(function()
                local targetButton = itemFrame:IsA("GuiButton") and itemFrame or itemFrame:FindFirstChildWhichIsA("GuiButton", true)
                if targetButton then
                    for _, conn in ipairs(getconnections(targetButton.MouseButton1Click)) do conn:Fire() end
                    for _, conn in ipairs(getconnections(targetButton.MouseButton1Down)) do conn:Fire() end
                end
            end)

            task.wait(0.3)
            sellHeldEgg()
            task.wait(0.9)
        end
    end
end

