local function CreateDropdown(tab, name, options, settingKey, callback)
    local savedSelection = currentSettings[settingKey] or {}
    local selectedItems = {}
    for _, v in pairs(savedSelection) do selectedItems[v] = true end

    local DropdownFrame = Instance.new("Frame", tab)
    DropdownFrame.BackgroundColor3 = Theme.Container
    DropdownFrame.Size = UDim2.new(0.92, 0, 0, 55)
    DropdownFrame.ClipsDescendants = true
    Instance.new("UICorner", DropdownFrame).CornerRadius = UDim.new(0, 10)
    Instance.new("UIStroke", DropdownFrame).Color = Theme.Stroke

    local MainBtn = Instance.new("TextButton", DropdownFrame)
    MainBtn.Size = UDim2.new(1, 0, 0, 55)
    MainBtn.BackgroundTransparency = 1
    MainBtn.Font = Enum.Font.GothamMedium
    MainBtn.Text = name
    MainBtn.TextColor3 = Theme.Text
    MainBtn.TextScaled = false
    MainBtn.TextSize = 18 
    MainBtn.TextXAlignment = Enum.TextXAlignment.Left
    
    local pad = Instance.new("UIPadding", MainBtn)
    pad.PaddingLeft = UDim.new(0, 15)

    local Arrow = Instance.new("TextLabel", MainBtn)
    Arrow.BackgroundTransparency = 1
    Arrow.AnchorPoint = Vector2.new(1, 0.5)
    Arrow.Position = UDim2.new(1, -15, 0.5, 0)
    Arrow.Size = UDim2.new(0, 24, 0, 24)
    Arrow.Font = Enum.Font.GothamBold
    Arrow.Text = "▼"
    Arrow.TextColor3 = Theme.TextDim
    Arrow.TextSize = 18

    local OptionsContainer = Instance.new("Frame", DropdownFrame)
    OptionsContainer.Position = UDim2.new(0, 0, 0, 55)
    OptionsContainer.Size = UDim2.new(1, 0, 1, -55)
    OptionsContainer.BackgroundTransparency = 1
    Instance.new("UIListLayout", OptionsContainer).SortOrder = Enum.SortOrder.LayoutOrder

    local isOpen = false
    MainBtn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        Tween(DropdownFrame, {Size = UDim2.new(0.92, 0, 0, isOpen and (55 + (#options * 45)) or 55)}, 0.3)
        Tween(Arrow, {Rotation = isOpen and 180 or 0}, 0.3)
    end)

    for _, opt in ipairs(options) do
        local OptBtn = Instance.new("TextButton", OptionsContainer)
        OptBtn.Size = UDim2.new(1, 0, 0, 45)
        OptBtn.BackgroundColor3 = selectedItems[opt] and Theme.Accent or Theme.Background
        OptBtn.BackgroundTransparency = selectedItems[opt] and 0.2 or 1
        OptBtn.Font = Enum.Font.GothamMedium
        OptBtn.Text = "•  " .. opt
        OptBtn.TextColor3 = selectedItems[opt] and Color3.fromRGB(255,255,255) or Theme.TextDim
        OptBtn.TextScaled = false
        OptBtn.TextSize = 16 
        OptBtn.TextXAlignment = Enum.TextXAlignment.Left
        OptBtn.AutoButtonColor = false
        
        local optPad = Instance.new("UIPadding", OptBtn)
        optPad.PaddingLeft = UDim.new(0, 30)

        OptBtn.MouseEnter:Connect(function() if not selectedItems[opt] then Tween(OptBtn, {BackgroundTransparency = 0.8}, 0.2) end end)
        OptBtn.MouseLeave:Connect(function() if not selectedItems[opt] then Tween(OptBtn, {BackgroundTransparency = 1}, 0.2) end end)

        OptBtn.MouseButton1Click:Connect(function()
            selectedItems[opt] = not selectedItems[opt]
            Tween(OptBtn, {
                BackgroundColor3 = selectedItems[opt] and Theme.Accent or Theme.Background,
                BackgroundTransparency = selectedItems[opt] and 0.2 or 1,
                TextColor3 = selectedItems[opt] and Color3.fromRGB(255,255,255) or Theme.TextDim
            }, 0.2)
            
            local result = {}
            for k, v in pairs(selectedItems) do if v then table.insert(result, k) end end
            currentSettings[settingKey] = result
            SaveSettings()
            callback(result)
        end)
    end
    task.spawn(function() callback(savedSelection) end)
end

