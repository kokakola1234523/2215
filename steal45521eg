local isAutoSellEnabled = false

-- ១. Function សម្រាប់លក់ Egg ដែលកំពុងកាន់ក្នុងដៃ
local function sellHeldEgg()
    local character = player.Character
    if not character then return end
    
    local tool = character:FindFirstChildWhichIsA("Tool")
    if tool then
        local itemType = tool:GetAttribute("ItemType")
        if itemType == "AssetEgg" or itemType == "PetEgg" then
            local eggUID = tool:GetAttribute("UID")
            if eggUID then
                local sellRemote = Constants.NETWORK_MAP.AssetInventory.SELL_ASSET
                Network.Fire(sellRemote, { eggUID })
                print("[Auto-Sell] បានលក់ Egg UID: " .. tostring(eggUID))
            end
        end
    end
end

-- ២. Function ដើរចុច Item ទាំងអស់ដែលមានក្នុង ScrollingFrame ម្តងមួយៗ
local function clickAllExistingItems()
    local items = scrollingFrame:GetChildren()

    for index, itemFrame in ipairs(items) do
        -- បើអ្នកប្រើប្រាស់បិទ Toggle កំឡុងពេលកំពុងរត់ ឱ្យឈប់ដំណើរការភ្លាមៗ
        if not isAutoSellEnabled then break end

        -- រំលង UI Layouts ផ្សេងៗ
        if itemFrame:IsA("GuiObject") and itemFrame.Name ~= "UIGridLayout" and itemFrame.Name ~= "UIListLayout" and itemFrame.Name ~= "UIPadding" and itemFrame.Name ~= "Template" then
            
            pcall(function()
                local targetButton = itemFrame:IsA("GuiButton") and itemFrame or itemFrame:FindFirstChildWhichIsA("GuiButton", true)
                
                if targetButton then
                    for _, connection in ipairs(getconnections(targetButton.MouseButton1Click)) do
                        connection:Fire()
                    end
                    for _, connection in ipairs(getconnections(targetButton.MouseButton1Down)) do
                        connection:Fire()
                    end
                    print(string.format("[Auto-Equip] (%d/%d) បានចុច Item: %s", index, #items, itemFrame.Name))
                end
            end)

            task.wait(0.3)
            sellHeldEgg()
            task.wait(0.9)
        end
    end

    print("[Auto Loop] បានដើរចុច និងលក់ Item ទាំងអស់ដែលមានក្នុង Inventory រួចរាល់!")
end

