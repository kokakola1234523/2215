local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- ដាក់ Raw Link Pastebin របស់អ្នកនៅទីនេះ
local pastebinUrl = "https://pastebin.com/raw/d1wW39Xe"

local allowedNames = {}
local success, response = pcall(function()
    return game:HttpGet(pastebinUrl)
end)

if success then
    -- បំបែកឈ្មោះតាមបន្ទាត់នីមួយៗ (Line)
    for name in response:gmatch("[^\r\n]+") do
        table.insert(allowedNames, name:match("^%s*(.-)%s*$")) -- លុប Space លើសចេញ
    end
else
    warn("មិនអាចទាញយកទិន្នន័យពី Pastebin បានទេ: " .. tostring(response))
end

-- ឆែកមើលថាតើឈ្មោះ Player មាននៅក្នុង List ដែរឬទេ
local isAllowed = false
for _, name in ipairs(allowedNames) do
    if LocalPlayer.Name == name then
        isAllowed = true
        break
    end
end

if isAllowed then
    loadstring(game:HttpGet("https://raw.githubusercontent.com/kokakola1234523/2215/refs/heads/main/2343g2"))()
else
    loadstring(game:HttpGet("https://raw.githubusercontent.com/kokakola1234523/2215/refs/heads/main/tte"))()
end
